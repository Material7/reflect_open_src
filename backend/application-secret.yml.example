# ローカル開発用シークレット設定ファイル
#
# このファイルを application-secret.yml にコピーし、値を生成して設定してください。
# application-secret.yml は .gitignore によりコミットされません。
#
#   cp application-secret.yml.example application-secret.yml
#
# 本番環境ではこのファイルではなく環境変数で渡してください。

credential:
  # VCS認証情報の AES-256-GCM 暗号化キー（32文字以上）
  # 生成例: openssl rand -base64 48 | tr -d '/+=\n'
  # ⚠ この鍵を失うと保存済みのVCS認証情報は復号不能になります
  encryption-key: "CHANGE_ME_CREDENTIAL_ENC_KEY"

jwt:
  # JWT署名キー（256bit=32文字以上のランダム文字列）
  # 生成例: openssl rand -base64 64
  secret: "CHANGE_ME_JWT_SECRET"

spring:
  datasource:
    # ローカル開発DBのパスワード
    password: "CHANGE_ME_DB_PASS"

server:
  ssl:
    # keytool で keystore.p12 を生成した際に指定したパスワード
    key-store-password: "CHANGE_ME_KEYSTORE_PASSWORD"
